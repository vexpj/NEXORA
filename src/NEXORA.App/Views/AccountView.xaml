<UserControl x:Class="NEXORA.App.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource FadeInRoot}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="Аккаунт" Style="{StaticResource PageTitle}" />

                <!-- Не выполнен вход -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0"
                        Visibility="{Binding IsLoggedOut, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Вход через Microsoft" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding SetupHint}" Style="{StaticResource Caption}" Margin="0,0,0,14" />
                        <Button Content="Войти через Microsoft" Command="{Binding LoginCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Вход выполнен -->
                <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="80" Height="80" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding SkinUrl}" Stretch="Fill" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.125,0.125,0.125,0.125" />
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding SkinUrl}" Stretch="Fill" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.625,0.125,0.125,0.125" />
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayerName}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PlayerId}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Выйти" Command="{Binding LogoutCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Скин" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="PNG 64×64 (или 64×32). Скин применится на серверах Mojang." Style="{StaticResource Caption}" Margin="0,0,0,10" />
                            <CheckBox Content="Тонкие руки (модель Alex / slim)" IsChecked="{Binding SlimArms}" Margin="0,0,0,12" />
                            <Button Content="Выбрать файл и загрузить…" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="UploadSkin_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Ник" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="3–16 символов: латиница, цифры, «_». Менять ник можно не чаще раза в 30 дней." Style="{StaticResource Caption}" Margin="0,0,0,10" />
                            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Проверить" Command="{Binding CheckNameCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                                <Button Content="Сменить ник" Command="{Binding ChangeNameCommand}" Style="{StaticResource GhostButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Плащ" Style="{StaticResource SectionTitle}" />
                            <ComboBox ItemsSource="{Binding Capes}" SelectedItem="{Binding SelectedCape, Mode=TwoWay}" DisplayMemberPath="Alias" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Надеть" Command="{Binding ApplyCapeCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                                <Button Content="Снять" Command="{Binding HideCapeCommand}" Style="{StaticResource GhostButton}" />
                            </StackPanel>
                            <TextBlock Text="Если плащей нет в списке, на аккаунте их пока нет." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,16,0,24" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
