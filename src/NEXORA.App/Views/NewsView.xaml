<UserControl x:Class="NEXORA.App.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource FadeInRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Center" />
            <TextBlock Text="Новости и обновления" Style="{StaticResource PageTitle}" />
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,8,0,16">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding LauncherInfo}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Updates.Notes}" Style="{StaticResource Caption}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Проверить обновления" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                        <Button Content="Скачать и установить" Command="{Binding InstallUpdateCommand}" Style="{StaticResource AccentButton}" Padding="18,8" FontSize="13"
                                Visibility="{Binding Updates.IsAvailable, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                    <Run Text="{Binding Type, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Date, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" Margin="0,8,0,0" Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
