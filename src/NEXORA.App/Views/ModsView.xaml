<UserControl x:Class="NEXORA.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource FadeInRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="Моды" Style="{StaticResource PageTitle}" />

        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0">
            <ComboBox ItemsSource="{Binding Profiles.Items}" SelectedItem="{Binding Profiles.Selected, Mode=TwoWay}"
                      DisplayMemberPath="Display" Width="260" Margin="0,0,10,8" />
            <ComboBox ItemsSource="{Binding Catalogs}" SelectedItem="{Binding SelectedCatalog, Mode=TwoWay}"
                      DisplayMemberPath="Name" Width="140" Margin="0,0,10,8" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,10,8" VerticalContentAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Найти" Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}" Padding="20,8" FontSize="13" Margin="0,0,10,8" />
            <Button Content="Папка модов" Command="{Binding OpenFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,8" />
        </WrapPanel>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,0,0,12" />

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Результаты поиска" Style="{StaticResource SectionTitle}" />
                <ListBox ItemsSource="{Binding Results}" ItemContainerStyle="{StaticResource RowItem}" Focusable="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource SecondarySurfaceBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                        <Run Text="{Binding Source, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Author, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding DownloadsText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Button Content="Установить" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Margin="0,0,0,4"
                                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Страница" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                            Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Установлено в профиле" Style="{StaticResource SectionTitle}" />
                <ListBox ItemsSource="{Binding Installed}" ItemContainerStyle="{StaticResource RowItem}" Focusable="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Content="{Binding ToggleText}" Style="{StaticResource GhostButton}" Padding="8,5" FontSize="12" Margin="0,0,4,0"
                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Удалить" Style="{StaticResource GhostButton}" Padding="8,5" FontSize="12"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
