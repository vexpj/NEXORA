<UserControl x:Class="NEXORA.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource FadeInRoot}">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}" Margin="0,24,0,0" HorizontalAlignment="Left" MaxWidth="560">
                <StackPanel>
                    <TextBlock Text="{Binding StageText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
