<UserControl x:Class="NEXORA.App.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource FadeInRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="Версии и профили" Style="{StaticResource PageTitle}" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Каталог Minecraft" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Снапшоты и старые версии" IsChecked="{Binding ShowAll}" Margin="0,0,0,10" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Установить" Command="{Binding InstallCommand}" Style="{StaticResource AccentButton}" Padding="18,8" FontSize="13" Margin="0,0,8,0" />
                        <Button Content="Удалить" Command="{Binding DeleteVersionCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                        <Button Content="Обновить список" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0,20,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Новый профиль" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Название (необязательно)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Загрузчик модов" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding LoaderTypes}" SelectedItem="{Binding SelectedLoader, Mode=TwoWay}" />
                    <TextBlock Text="Версия загрузчика" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding SelectedLoaderVersion, Mode=TwoWay}"
                              IsEnabled="{Binding CanPickLoaderVersion}" />
                    <Button Content="Создать профиль" Command="{Binding CreateProfileCommand}" Style="{StaticResource AccentButton}"
                            Padding="18,9" FontSize="13" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    <TextBlock Text="Профиль создаётся для версии, выбранной слева." Style="{StaticResource Caption}" Margin="0,8,0,0" />

                    <TextBlock Text="Мои профили" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                    <ListBox ItemsSource="{Binding Profiles.Items}" ItemContainerStyle="{StaticResource RowItem}" Focusable="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SecondarySurfaceBrush}" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Top">
                                        <Image Source="{Binding IconPath}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Content="Файл…" ToolTip="Сохранить сборку в файл" Style="{StaticResource GhostButton}" Padding="9,4" FontSize="12" Margin="0,0,6,4" Click="ExportPack_Click" />
                                            <Button Content="Код" ToolTip="Скопировать код сборки" Style="{StaticResource GhostButton}" Padding="9,4" FontSize="12" Margin="0,0,6,4"
                                                    Command="{Binding DataContext.CopyShareCodeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Картинка…" Style="{StaticResource GhostButton}" Padding="9,4" FontSize="12" Margin="0,0,6,4" Click="SetIcon_Click" />
                                            <Button Content="Удалить" Style="{StaticResource GhostButton}" Padding="9,4" FontSize="12" Margin="0,0,0,4"
                                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,16,0,0" />

                    <TextBlock Text="Обмен сборками" Style="{StaticResource SectionTitle}" Margin="0,24,0,6" />
                    <TextBlock Text="Сборка — это список модов со ссылками и контрольными суммами, а не сами файлы: друг скачает всё с официальных сайтов и NEXORA всё проверит." Style="{StaticResource Caption}" Margin="0,0,0,10" />
                    <CheckBox Content="Включать настройки модов (config), без ключей и токенов" IsChecked="{Binding IncludeConfigs}" Margin="0,0,0,12" />
                    <Button Content="Открыть файл сборки…" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="ImportPackFile_Click" />
                    <TextBlock Text="…или вставьте код сборки" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Прочитать" Command="{Binding LoadPackCodeCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding PackCodeInput, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <Border Background="{DynamicResource SecondarySurfaceBrush}" CornerRadius="10" Padding="16" Margin="0,14,0,0"
                            Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding Pending}">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,2,0,8" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding ModList}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}">
                        <Button Content="Установить сборку" Command="{Binding ConfirmImportCommand}" Style="{StaticResource AccentButton}" Padding="18,8" FontSize="13" Margin="0,0,8,0" />
                        <Button Content="Отмена" Command="{Binding CancelImportCommand}" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PackStatus}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
