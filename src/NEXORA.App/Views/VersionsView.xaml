<UserControl x:Class="NEXORA.App.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource FadeInRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="Версии и профили" Style="{StaticResource PageTitle}" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Каталог Minecraft" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Снапшоты и старые версии" IsChecked="{Binding ShowAll}" Margin="0,0,0,10" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <ProgressBar Value="{Binding Progress}" Maximum="100" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Установить" Command="{Binding InstallCommand}" Style="{StaticResource AccentButton}" Padding="18,8" FontSize="13" Margin="0,0,8,0" />
                        <Button Content="Удалить" Command="{Binding DeleteVersionCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                        <Button Content="Обновить список" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0,20,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Новый профиль" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Название (необязательно)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Загрузчик модов" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding LoaderTypes}" SelectedItem="{Binding SelectedLoader, Mode=TwoWay}" />
                    <TextBlock Text="Версия загрузчика" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding SelectedLoaderVersion, Mode=TwoWay}"
                              IsEnabled="{Binding CanPickLoaderVersion}" />
                    <Button Content="Создать профиль" Command="{Binding CreateProfileCommand}" Style="{StaticResource AccentButton}"
                            Padding="18,9" FontSize="13" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    <TextBlock Text="Профиль создаётся для версии, выбранной слева." Style="{StaticResource Caption}" Margin="0,8,0,0" />

                    <TextBlock Text="Мои профили" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                    <ListBox ItemsSource="{Binding Profiles.Items}" ItemContainerStyle="{StaticResource RowItem}" Focusable="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="Удалить" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12"
                                            Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
