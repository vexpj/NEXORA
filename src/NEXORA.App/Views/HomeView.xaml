<UserControl x:Class="NEXORA.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource FadeInRoot}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,24">
                <TextBlock Text="{Binding Welcome}" Style="{StaticResource PageTitle}" />

                <!-- Запуск -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="12" Background="{DynamicResource SecondarySurfaceBrush}" Margin="0,0,16,0" VerticalAlignment="Top" ClipToBounds="True">
                                <Image Source="{Binding Profiles.Selected.IconPath}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Профиль" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Profiles.Items}" SelectedItem="{Binding Profiles.Selected, Mode=TwoWay}"
                                          DisplayMemberPath="Display" MaxWidth="440" HorizontalAlignment="Left" MinWidth="300" />
                                <TextBlock Text="{Binding NoProfileHint}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding AccountText}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Остановить" Command="{Binding StopCommand}" Style="{StaticResource GhostButton}" Margin="0,0,12,0" />
                                <Button Content="ИГРАТЬ" Command="{Binding PlayCommand}" Style="{StaticResource AccentButton}" MinWidth="160" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,18,0,8" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>

                <!-- Что пошло не так -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Обнаружена проблема запуска" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Diagnoses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SecondarySurfaceBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,10"
                                            BorderBrush="{Binding SeverityColor}" BorderThickness="3,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,10" />
                                            <ItemsControl ItemsSource="{Binding Fixes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Label}" Command="{Binding Apply}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding DiagnosisNote}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="Все действия обратимы и не затрагивают ваши миры и сохранения." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Мониторинг -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding Monitoring, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Мониторинг игры" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding CpuText}" />
                        <ProgressBar Value="{Binding CpuValue, Mode=OneWay}" Maximum="100" Margin="0,6,0,12" />
                        <TextBlock Text="{Binding RamText}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding RamValue, Mode=OneWay}" Maximum="100" Margin="0,6,0,12" />
                        <TextBlock Text="{Binding GpuText}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding GpuValue, Mode=OneWay}" Maximum="100" Margin="0,6,0,12" />
                        <TextBlock Text="{Binding MemoryHint}" Foreground="#FBBF24" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FpsText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Журнал игры" Style="{StaticResource SectionTitle}" />
                        <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" Text="{Binding LogText, Mode=OneWay}" Height="260" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
